{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pristine",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "pristine-phone",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3001",
        "-H",
        "0.0.0.0",
        "--experimental-https"
      ],
      "port": 3001,
      "url": "https://localhost:3001"
    },
    {
      "name": "pristine-built",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3002"
      ],
      "port": 3002
    }
  ]
}
